# --- Base de datos MySQL Server ---
# La cuenta de ejecución solo tiene permisos de lectura y escritura de datos.
DB_NAME=agronomia
DB_USER=agronomia_api
DB_PASSWORD=TU_PASSWORD_MYSQL
DB_HOST=127.0.0.1
DB_PORT=3306

# Solo scripts/migrar-db.ps1 usa esta cuenta.
DB_MIGRATE_USER=agronomia_admin
DB_MIGRATE_PASSWORD=TU_PASSWORD_MIGRACIONES

# --- Almacenamiento de imágenes ---
UPLOAD_DIR=../media/plant-images

# --- Servidor Django ---
DJANGO_SECRET_KEY=TU_SECRETO_DJANGO
# Activa esto solo en un entorno aislado que no tenga una clave configurada.
DJANGO_ALLOW_INSECURE_KEY=false
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
