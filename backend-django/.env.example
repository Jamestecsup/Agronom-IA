# --- Base de datos MySQL Server ---
# La cuenta de ejecución solo tiene permisos de lectura y escritura de datos.
DB_NAME=agronomia
DB_USER=agronomia_api
DB_PASSWORD=TU_PASSWORD_MYSQL
DB_HOST=127.0.0.1
DB_PORT=3306

# Solo scripts/migrar-db.ps1 usa esta cuenta.
DB_MIGRATE_USER=agronomia_admin
DB_MIGRATE_PASSWORD=TU_PASSWORD_MIGRACIONES

# --- Claves de IA (nunca en Git) ---
PLANTNET_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Horarios semanales (Django autentica/guarda; Spring procesa el PDF y propone cuidados)
SPRING_SCHEDULE_URL=http://127.0.0.1:8081
ADMIN_TOKEN_SECRET=TU_SECRETO_ADMIN
SCHEDULE_INTERNAL_TOKEN=TU_TOKEN_INTERNO

# --- Almacenamiento de imágenes ---
PLANT_UPLOAD_DIR=../media/plant-images

# --- Servidor Django ---
DJANGO_SECRET_KEY=TU_SECRETO_DJANGO
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
