# Copia estos nombres/valores al entorno del proceso.
# Spring Boot no carga archivos .env automáticamente.
DB_URL=jdbc:mysql://127.0.0.1:3306/agronomia
DB_USERNAME=agronomia_api
DB_PASSWORD=TU_PASSWORD_MYSQL
DB_MIGRATE_USER=agronomia_admin
DB_MIGRATE_PASSWORD=TU_PASSWORD_MIGRACIONES
UPLOAD_DIR=../media/plant-images
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
UPLOAD_TEMP_DIR=../media/upload-tmp

# Autenticación de la API de usuario
USER_TOKEN_SECRET=TU_SECRETO_ALEATORIO_USUARIO

# Servicios por proceso Spring
PLANTNET_API_KEY=TU_API_KEY_AQUI
AI_API_KEY=TU_API_KEY_AQUI
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AI_DEBUG_RESPONSES=false
AI_CANDIDATE_HINTS=false
# AI_SENSITIVE_TERMS añade palabras y frases separadas por comas al filtro de fichas.
# AI_SENSITIVE_TERMS=
# AI_VISION_MODEL usa AI_MODEL cuando se omite.
