# Copia estos nombres/valores al entorno del proceso.
# Spring Boot no carga archivos .env automáticamente.
DB_URL=jdbc:mariadb://127.0.0.1:3306/agronomia
DB_USERNAME=root
DB_PASSWORD=
PLANT_UPLOAD_DIR=C:/xampp/plant-images
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
UPLOAD_TEMP_DIR=C:/xampp/tmp/agronomia-upload-tmp

# --- Panel de administración ---
# Cambia el secreto fuera del repositorio en cualquier equipo compartido.
ADMIN_TOKEN_SECRET=cambia-este-secreto
ADMIN_TOKEN_TTL_HOURS=8
ADMIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
