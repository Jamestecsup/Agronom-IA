# Copia estos nombres/valores no secretos al entorno del proceso.
# Spring Boot no carga archivos .env automáticamente.
DB_URL=jdbc:mariadb://127.0.0.1:3306/agronomia
DB_USERNAME=agronomia_api
DB_PASSWORD=replace-with-a-local-secret
PLANT_UPLOAD_DIR=C:/xampp/plant-images
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
UPLOAD_TEMP_DIR=C:/xampp/tmp/agronomia-upload-tmp
OPENCODE_SERVER_BASE_URL=http://127.0.0.1:4096
# OpenCode optional Basic Auth; leave blank for local development without auth.
OPENCODE_USERNAME=
OPENCODE_PASSWORD=
OPENWEBUI_BASE_URL=http://192.168.17.11:3000
OPENWEBUI_API_KEY=replace-with-a-local-secret
OPENWEBUI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
AI_CHAT_CONNECT_TIMEOUT=5s
AI_CHAT_READ_TIMEOUT=180s
