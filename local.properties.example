## local.properties.example
## Copia este archivo como 'local.properties' y asigna los valores correspondientes.
## local.properties NO se versiona (está en .gitignore).

# Ubicación del Android SDK (Android Studio suele configurarla solo)
# sdk.dir=C\:\\Users\\USER\\AppData\\Local\\Android\\Sdk

# --- Backend Django (servicio de usuario) ---
# La app solo habla con Django: las claves de Pl@ntNet y de Gemini viven en
# backend-django/.env y nunca se empaquetan en el APK.
#
# Emulador: 10.0.2.2 es la PC anfitriona.
BACKEND_BASE_URL=http://10.0.2.2:8000/
#
# Móvil físico en la misma red: usa la IP de la PC, por ejemplo
# BACKEND_BASE_URL=http://192.168.1.20:8000/
