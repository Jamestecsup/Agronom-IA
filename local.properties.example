## local.properties.example
## Copia este archivo como 'local.properties' y asigna los valores correspondientes.

# Ubicacion del Android SDK (generalmente configurado de forma automatica por Android Studio)
# sdk.dir=C\:\\Users\\USER\\AppData\\Local\\Android\\Sdk

# Configuracion del servicio de Inteligencia Artificial
# Tu URL base y API key personales. NO escribas valores reales aqui:
# este archivo SI se versiona. Copia el ejemplo a 'local.properties' y ahi
# coloca tus credenciales (local.properties esta en .gitignore).

# --- Google Gemini (endpoint compatible con OpenAI) ---
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=TU_API_KEY_AQUI
AI_MODEL=gemini-3.8-flash
AI_IDENTIFY_PATH=chat/completions

# --- Alternativa: OpenAI ---
# AI_BASE_URL=https://api.openai.com/
# AI_MODEL=gpt-4o-mini
# AI_IDENTIFY_PATH=v1/chat/completions

# --- Alternativa: servidor local (Ollama / LM Studio) ---
# AI_BASE_URL=http://192.168.1.10:11434/v1/
# AI_MODEL=llama3.2-vision
# AI_IDENTIFY_PATH=chat/completions

# --- IA ORIGINAL (institucional, red privada) ---
# Ver docs/CONFIG-IA.md. Endpoint: http://192.168.17.11:3000/v1/chat/completions
# AI_BASE_URL=http://192.168.17.11:3000/
# AI_MODEL=gpt-4o-mini
# AI_IDENTIFY_PATH=v1/chat/completions